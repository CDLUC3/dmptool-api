{
  "name": "dmptool-api",
  "description": "DMP Tool API",
  "version": "3.0.0",
  "author": "University of California Curation Center (UC3)<dmptool@ucop.edu>",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDLUC3/dmptool-api.git"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && npm run compile",
    "compile": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "generate": "graphql-codegen --config codegen.ts",
    "lint": "npx eslint . --ignore-pattern dist/ --ignore-pattern src/generated",
    "prepare": "is-ci || npx husky install",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "trivy-high": "sh ./src/scripts/trivy-high.sh",
    "trivy-med": "sh ./src/scripts/trivy-med.sh",
    "trivy-all": "npm run trivy-high && npm run trivy-med"
  },
  "overrides": {
    "fast-uri": "4.1.2",
    "graphql": "^17.0.2"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@dmptool/types": "^4.0.1",
    "@dmptool/utils": "^2.1.7",
    "@fastify/accept-negotiator": "^2.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/error": "^4.2.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/routes": "^6.0.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-cli": "^8.0.0",
    "graphql": "^17.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@types/node": "^16.2.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-expect-message": "^1.1.3",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "latest"
  }
}
