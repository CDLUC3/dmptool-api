{
  "name": "dmptool-api",
  "description": "DMP Tool API",
  "version": "3.0.0",
  "author": "University of California Curation Center (UC3)<dmptool@ucop.edu>",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDLUC3/dmptool-api.git"
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=11.3.0"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "npx eslint . --ignore-pattern dist/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "trivy-high": "sh ./src/scripts/trivy-high.sh",
    "trivy-med": "sh ./src/scripts/trivy-med.sh",
    "trivy-all": "npm run trivy-high && npm run trivy-med"
  },
  "dependencies": {
    "@dmptool/types": "^3.1.3",
    "@dmptool/utils": "^1.0.43",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/routes": "^6.0.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-cli": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "babel-jest": "^30.3.0",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-expect-message": "^1.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
