{
  "name": "dmptool-api",
  "description": "DMP Tool API",
  "version": "3.0.0",
  "author": "University of California Curation Center (UC3)<dmptool@ucop.edu>",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDLUC3/dmptool-api.git"
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=11.3.0"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "npx eslint . --ignore-pattern dist/",
    "test": "jest --coverage",
    "trivy-high": "sh ./src/scripts/trivy-high.sh",
    "trivy-med": "sh ./src/scripts/trivy-med.sh",
    "trivy-all": "npm run trivy-high && npm run trivy-med"
  },
  "dependencies": {
    "@dmptool/types": "^3.1.3",
    "@dmptool/utils": "^1.0.43",
    "@fastify/auth": "^5.0.4",
    "@fastify/caching": "^9.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/mysql": "^5.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/routes": "^6.0.2",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-cli": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jest": "^30.3.0",
    "jest-expect-message": "^1.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
