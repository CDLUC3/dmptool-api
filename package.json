{
  "name": "dmptool-api",
  "description": "DMP Tool API",
  "version": "3.0.0",
  "author": "University of California Curation Center (UC3)<dmptool@ucop.edu>",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDLUC3/dmptool-api.git"
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=11.3.0"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "generate": "graphql-codegen --config codegen.ts",
    "lint": "npx eslint . --ignore-pattern dist/ --ignore-pattern src/generated",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "trivy-high": "sh ./src/scripts/trivy-high.sh",
    "trivy-med": "sh ./src/scripts/trivy-med.sh",
    "trivy-all": "npm run trivy-high && npm run trivy-med"
  },
  "overrides": {
    "fast-jwt": "6.2.4",
    "fast-uri": "3.1.2",
    "fast-xml-parser": "5.8.0"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@dmptool/types": "^3.1.5",
    "@dmptool/utils": "^2.1.1",
    "@fastify/accept-negotiator": "^2.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/routes": "^6.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-cli": "^7.4.1",
    "graphql": "^16.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.0.0",
    "@types/node": "^25.7.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-expect-message": "^1.1.3",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "latest"
  }
}
