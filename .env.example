# Environment settings
NODE_ENV=development    # Used by the Node.js app
DEPLOYMENT_ENV=dev      # Used to determine which environment the app is running in

# Logging
LOG_LEVEL=debug

# The path prefix for the API (without trailing slash)
API_V3_PATH_PREFIX=/api/v3

# The domain name for the API (without trailing slash)
API_DOMAIN=localhost:4060
# The port for the API
API_PORT=4060

# The name of your API Application
APPLICATION_NAME=my-api

# The JWT info
AUTH_JWKS_URI=http://localhost:4646/.well-known/jwks
# The issuer claim expected in access tokens
TOKEN_ISSUER=http://localhost:4646
# The OAuth audience expected in access tokens
TOKEN_AUDIENCES=dmptool-api
ACCESS_TOKEN_NAME=dmptool_access
REFRESH_TOKEN_NAME=dmptool_refresh

# The DMP Id components (used when generating dmp_id URLs for registered Plans)
DMP_ID_BASE_URL=https://doi.org  # (without trailing slash)
DMP_ID_SHOULDER=00.00000/A1

# The maximum allowed size for a DMP JSON payload
DMP_PAYLOAD_SIZE_LIMIT_MB=50

# The domain and port that can be used to fetch the Schema declaration for the
# GraphQL server (used by the GraphQL codegen tool to generate types and resolvers)
CODEGEN_GRAPHQL_URI=http://localhost:4000/graphql

# The domain and port that can be used to download the DMP narrative
NARRATIVE_DOWNLOAD_DOMAIN=localhost
NARRATIVE_DOWNLOAD_PORT=4030

# The domain and port where the DMP landing page lives
LANDING_PAGE_DOMAIN=localhost
LANDING_PAGE_PORT=4060

# Also refer to the ENV variables defined in the local docker-compose.yaml file
# those variables will need to be defined along with the ones above when you
# deploy the application to a production environment
